{
	"name": "@liminal-hq/waypoint-chrome",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"description": "Shared Liminal HQ window chrome: title bar, window menu, context menu. No Waypoint domain imports.",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ci": "mkdir -p ../../test-results && vitest run --reporter=default --reporter=junit --outputFile.junit=../../test-results/chrome-junit.xml"
	},
	"peerDependencies": {
		"react": "^19.1.0",
		"react-dom": "^19.1.0"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.10.1"
	},
	"devDependencies": {
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"happy-dom": "^20.8.4",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"typescript": "~5.8.3",
		"vitest": "^4.1.9"
	}
}
