{
	"name": "@liminal-hq/waypoint",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"tauri:dev": "WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri dev --config src-tauri/tauri.conf.dev.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ci": "mkdir -p ../../test-results && vitest run --reporter=default --reporter=junit --outputFile.junit=../../test-results/junit.xml",
		"predev": "bun run --cwd ../.. build:plugins",
		"prebuild": "bun run --cwd ../.. build:plugins",
		"pretypecheck": "bun run --cwd ../.. build:plugins",
		"pretest": "bun run --cwd ../.. build:plugins",
		"pretest:ci": "bun run --cwd ../.. build:plugins"
	},
	"dependencies": {
		"@liminal-hq/plugin-os-prefs": "workspace:*",
		"@liminal-hq/plugin-thumbnails": "workspace:*",
		"@liminal-hq/plugin-trash": "workspace:*",
		"@liminal-hq/plugin-volumes": "workspace:*",
		"@liminal-hq/plugin-secrets": "workspace:*",
		"@liminal-hq/plugin-mime-apps": "workspace:*",
		"@liminal-hq/plugin-system-appearance": "workspace:*",
		"@liminal-hq/plugin-window-effects": "workspace:*",
		"@liminal-hq/plugin-window-manager": "workspace:*",
		"@liminal-hq/plugin-native-dnd": "workspace:*",
		"@liminal-hq/plugin-window-tearoff": "workspace:*",
		"@liminal-hq/waypoint-plugin-ops": "workspace:*",
		"@liminal-hq/waypoint-plugin-session": "workspace:*",
		"@liminal-hq/waypoint-plugin-git": "workspace:*",
		"@liminal-hq/waypoint-plugin-settings": "workspace:*",
		"@liminal-hq/waypoint-chrome": "workspace:*",
		"@liminal-hq/waypoint-plugin-vfs": "workspace:*",
		"@liminal-hq/waypoint-protocol": "workspace:*",
		"@tanstack/react-router": "^1.170.33",
		"@tanstack/react-virtual": "^3.14.13",
		"@tauri-apps/api": "^2.10.1",
		"@tauri-apps/plugin-log": "^2.8.0",
		"@tauri-apps/plugin-os": "^2.3.2",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"zustand": "^5.0.12"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"happy-dom": "^20.8.4",
		"typescript": "~5.8.3",
		"vite": "^7.0.4",
		"vitest": "^4.1.9"
	}
}
