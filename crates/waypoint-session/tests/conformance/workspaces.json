{
	"description": "Workspaces: save a group as one, de-duplicate its folders, reject a repeated name, rename, edit the folders, switch one window to it, and delete it. Both runners must agree on every step.",
	"steps": [
		{ "do": { "op": "open", "location": "/a" }, "expect": { "tabs": [1] } },
		{ "do": { "op": "open", "location": "/b", "activate": false }, "expect": { "tabs": [1, 2] } },
		{ "do": { "op": "open", "location": "/a", "activate": false }, "expect": { "tabs": [1, 2, 3] } },
		{ "do": { "op": "open", "location": "/z", "activate": false }, "expect": { "tabs": [1, 2, 3, 4] } },
		{
			"do": { "op": "createGroup", "tabs": [1, 2, 3], "name": "Site" },
			"expect": { "groups": [{ "id": 1, "name": "Site", "collapsed": false, "tabs": [1, 2, 3] }] }
		},
		{
			"do": { "op": "saveGroupAsWorkspace", "group": 1 },
			"note": "the name defaults to the group's, and a folder open twice is kept once, in strip order",
			"expect": {
				"workspaces": [{ "id": 1, "name": "Site", "locations": ["/a", "/b"] }],
				"workspace": null
			}
		},
		{
			"do": { "op": "saveGroupAsWorkspace", "group": 1, "name": " site " },
			"note": "names are compared ignoring case and surrounding space",
			"error": true,
			"expect": { "workspaces": [{ "id": 1, "name": "Site", "locations": ["/a", "/b"] }] }
		},
		{
			"do": { "op": "saveGroupAsWorkspace", "group": 1, "name": "Copy" },
			"expect": {
				"workspaces": [
					{ "id": 1, "name": "Site", "locations": ["/a", "/b"] },
					{ "id": 2, "name": "Copy", "locations": ["/a", "/b"] }
				]
			}
		},
		{ "do": { "op": "saveGroupAsWorkspace", "group": 1, "name": "  " }, "error": true },
		{ "do": { "op": "renameWorkspace", "workspace": 2, "name": "SITE" }, "error": true },
		{
			"do": { "op": "renameWorkspace", "workspace": 1, "name": "SITE" },
			"note": "a workspace may change the case of its own name",
			"expect": {
				"workspaces": [
					{ "id": 1, "name": "SITE", "locations": ["/a", "/b"] },
					{ "id": 2, "name": "Copy", "locations": ["/a", "/b"] }
				]
			}
		},
		{
			"do": { "op": "setWorkspaceLocations", "workspace": 2, "locations": ["/q", "/r", "/q"] },
			"expect": {
				"workspaces": [
					{ "id": 1, "name": "SITE", "locations": ["/a", "/b"] },
					{ "id": 2, "name": "Copy", "locations": ["/q", "/r"] }
				]
			}
		},
		{ "do": { "op": "setActiveWorkspace", "workspace": 9 }, "error": true },
		{ "do": { "op": "setActiveWorkspace", "workspace": 2 }, "expect": { "workspace": 2 } },
		{
			"do": { "op": "openWindow", "location": "/w" },
			"note": "the active workspace is per window",
			"expect": { "others": { "main-2": { "workspace": null } } }
		},
		{ "do": { "op": "deleteWorkspace", "workspace": 2 }, "expect": { "workspace": null } },
		{ "do": { "op": "deleteWorkspace", "workspace": 2 }, "error": true },
		{
			"do": { "op": "saveGroupAsWorkspace", "group": 1, "name": "Again" },
			"note": "ids are never reused",
			"expect": {
				"workspaces": [
					{ "id": 1, "name": "SITE", "locations": ["/a", "/b"] },
					{ "id": 3, "name": "Again", "locations": ["/a", "/b"] }
				]
			}
		}
	]
}
